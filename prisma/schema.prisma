datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String           @id @default(uuid())
  name          String?
  email         String           @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  mealPlans     SavedMealPlan[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Account {
  id                String   @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreferences {
  id                  String   @id @default(uuid())
  userId              String   @unique
  wakeUpTime          String
  sleepTime           String
  mealFrequency       Int
  dailySchedule       String
  fitnessGoal         String
  dietaryRestrictions String[]
  allergies           String[]
  cuisinePreference   String[]
  budget              Float
  numberOfPeople      Int
  cookingSkillLevel   String
  availableCookingTime Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedMealPlan {
  id          String            @id @default(uuid())
  userId      String
  name        String
  startDate   DateTime
  endDate     DateTime
  meals       Json
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  groceryList SavedGroceryList?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SavedGroceryList {
  id         String   @id @default(uuid())
  mealPlanId String   @unique
  items      Json
  budgetCost Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mealPlan SavedMealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
}
